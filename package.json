{
  "name": "allforone",
  "version": "0.2.3",
  "description": "Qoder capability pack, local Codex plugin, and portable ChatGPT workflows.",
  "type": "module",
  "bin": {
    "allforone": "bin/allforone.mjs"
  },
  "files": [
    ".qoder-plugin/",
    ".mcp.json",
    "assets/",
    "bin/",
    "commands/",
    "hooks/",
    "knowledge/",
    "lib/",
    "memory/",
    "profiles.json",
    "skills/",
    "tools/",
    "upstreams/",
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses/",
    "SECURITY.md",
    "NOTICE",
    "assets/README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node scripts/validate.mjs && node scripts/build-codex-marketplace.mjs --check",
    "check:readme": "node scripts/check-readme-sync.mjs",
    "privacy": "node scripts/privacy-scan.mjs --history",
    "pack": "node scripts/build-zip.mjs",
    "pack:chatgpt": "node scripts/build-chatgpt.mjs",
    "build:codex": "node scripts/build-codex-marketplace.mjs --write"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
